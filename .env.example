# Local Compose defaults. Real .env is ignored; choose private deployment credentials.
POSTGRES_DB=catan
POSTGRES_USER=catan
POSTGRES_PASSWORD=catan-local-only
CATAN_WEB_PORT=80
# Optional explicit postgresql+psycopg URL overrides the PostgreSQL fields above.
# Passwords in an explicit URL must be percent encoded; fields above handle symbols automatically.
DATABASE_URL=
CATAN_ENABLE_TEST_TOOLS=0
# Admission only: join/reconnect/Continue/rematch do not consume creation budgets.
CATAN_ROOM_CREATE_LIMIT=20
CATAN_ROOM_CREATE_WINDOW_SECONDS=600
CATAN_ROOM_CREATE_LOBBIES_PER_IP=20
CATAN_ROOM_CREATE_LOBBIES_GLOBAL=1000
# Used only by explicit memory mode; durable mode reads PostgreSQL metadata.
CATAN_ROOM_CREATE_TRACKING_CAPACITY=4096
# Explicit local HTTP auth only. Production: production + exact HTTPS origin(s).
CATAN_AUTH_MODE=development
CATAN_AUTH_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
