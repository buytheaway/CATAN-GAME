# Local Compose defaults. Real .env is ignored; choose private deployment credentials.
POSTGRES_DB=catan
POSTGRES_USER=catan
POSTGRES_PASSWORD=catan-local-only
CATAN_WEB_PORT=80
# Optional explicit postgresql+psycopg URL overrides the PostgreSQL fields above.
# Passwords in an explicit URL must be percent encoded; fields above handle symbols automatically.
DATABASE_URL=
CATAN_ENABLE_TEST_TOOLS=0
